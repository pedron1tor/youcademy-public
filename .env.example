# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file.

# --- Core (required for local development) ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
DJANGO_SETTINGS_MODULE=mainframe.settings.local

# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# Used for the writing editor and reading data.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# --- AI features ---
# OpenAI: text generation, quiz grading, text simplification
OPENAI_KEY=
# Groq: used for topic suggestions
GROQ_API_KEY=

# --- Pronunciation scoring (SpeechSuper) ---
SPEECHSUPER_APP_KEY=
SPEECHSUPER_SECRET_KEY=

# --- Social login (optional) ---
# Google OAuth
CLIENT_ID=
CLIENT_SECRET=
# Microsoft OAuth
MSFT_CLIENT_ID=
MSFT_SECRET=

# --- Payments (optional) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# --- Google Cloud (production deployment only) ---
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GS_BUCKET_NAME=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# TOPIC_NAME=
# REDISHOST=
# CLOUDRUN_SERVICE_URL=
